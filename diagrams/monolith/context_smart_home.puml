@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Smart Home System Diagram

Person(customer, "Smart Home Customer", "House owner")

System(smart_home_service, "Smart Home System", "Allows user to control sensors and get temperature info")

System_Ext(temperature_service, "Sensor API System", "Manages sensors and read temperature")

Rel(customer, smart_home_service, "Uses")
Rel(smart_home_service, temperature_service, "Uses")

@enduml